# ---------- Google Sheets ----------
# ID nằm trong URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Leads

# Cách 1 (khuyến nghị): Service Account - nhớ share Sheet cho email của service account (quyền Editor)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json

# Cách 2: OAuth 2.0 user (chỉ dùng khi để trống GOOGLE_SERVICE_ACCOUNT_FILE)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ---------- Bitrix24 ----------
# Inbound webhook có quyền CRM, dạng https://<portal>.bitrix24.vn/rest/<user_id>/<token>/
BITRIX_WEBHOOK_URL=
# Khoảng cách tối thiểu giữa 2 request (Bitrix cho ~2 request/giây)
BITRIX_MIN_INTERVAL_MS=500
# Real-time (two-way): application_token của Outbound webhook (Bitrix24 -> POST /webhooks/bitrix)
BITRIX_OUTBOUND_TOKEN=
# Gộp các sự kiện webhook đến dồn dập trong khoảng này thành 1 lần đồng bộ
WEBHOOK_DEBOUNCE_MS=3000

# ---------- Sync ----------
# Mapping + chiều đồng bộ (sync.direction) + ưu tiên khi xung đột (sync.conflictPriority); sửa được trên admin panel
MAPPING_FILE=config/mapping.json
# Cron: */15 * * * * (15 phút) | 0 * * * * (mỗi giờ) | 0 8 * * * (8h sáng hằng ngày)
SYNC_CRON=*/15 * * * *
TZ=Asia/Ho_Chi_Minh
RETRY_MAX=3
RETRY_BASE_DELAY_MS=1000

# ---------- Server / logging ----------
PORT=3000
# Bảo vệ admin panel + API (POST /sync, /status, /api/*): header "Authorization: Bearer <ADMIN_TOKEN>"
ADMIN_TOKEN=
# Để trống để chỉ log ra console
LOG_FILE=logs/sync.log
